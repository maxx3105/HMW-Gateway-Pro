<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  hmw_lgw_dual.xml : Geraetebeschreibung fuer das HMW-Gateway-Pro-Dual.
  Das Gateway meldet sich zusaetzlich als HMW-Busgeraet an und wird dadurch in der CCU
  konfigurierbar (Vorbild HmIPW-DRAP: Betriebsart als Geraeteparameter).

  VERIFIZIERT am echten System (OpenCCU): Ein EIGENES Typ-Byte funktioniert - es braucht
  NUR diese XML in /firmware/hs485types/ der CCU, an der das Gateway haengt. KEIN Eintrag in
  /firmware/fwmap, KEIN Kapern eines vorhandenen eq3-Geraetetyps.
  Hier: Typ 0xab (= 171), HW-Version 0 - muss mit /config im Gateway uebereinstimmen.

  SCHREIBWEISE (am System festgestellt): const_value hier als Hex mit KLEINEN Buchstaben
  ("0xab"), passend zur Anzeige des Gateways. Bei "0xAB" wurde der Typ nicht erkannt.
  eq3-eigene XMLs schreiben stattdessen dezimal ("27" = 0x1B) - das ist ebenfalls gaengig,
  hier aber ungetestet. Wer die Schreibweise aendert: danach neu erkennen lassen und
  pruefen, ob das Geraet noch mit eigener Typenbezeichnung erscheint.

  Datei mit LF-Zeilenenden, ISO-8859-1 ohne BOM.
  ACHTUNG: auch die Typ-id ("HMW-LGW-Dual") wird CASE-SENSITIV verglichen. Wer ein
  Geraetebild oder Uebersetzungen ergaenzt (devdb.csv, Stringtable), muss sie zeichengenau
  uebernehmen - Abweichungen melden keinen Fehler, das Bild fehlt dann einfach lautlos.
  Achtung: /firmware/ ueberlebt kein CCU-Update - fuer Dauerbetrieb per Addon ausliefern.

  Das EEPROM-Layout unten MUSS exakt zu encodeSelfEeprom()/applySelfEeprom() im Sketch passen.
-->
<device eep_size="1024" version="01">

  <supported_types>
    <type id="HMW-LGW-Dual" name="RS485 Homebrew LAN Gateway Dual-Bus" priority="2">
      <parameter const_value="0xab" index="0" size="1"/> <!-- deviceType ('h'); 0xab = 171. KLEIN schreiben, s.o. -->
      <parameter const_value="0"  index="1" size="1"/>   <!-- HW-Version ('h') -->
    </type>
  </supported_types>

  <paramset id="hmw_lgw_dual_dev_master" type="MASTER">

    <!-- Bus-Betriebsart: das Gegenstueck zum DRAP-Dropdown "Buskonfiguration".
         Wird gespeichert und angewendet; wirksam wird RING/SPLIT mit dem Dual-Bus-Umbau. -->
    <parameter id="BUS_MODE">
      <logical type="option">
        <option id="SINGLE" default="true"/>
        <option id="RING"/>
        <option id="SPLIT"/>
      </logical>
      <physical interface="eeprom" size="1.0" type="integer"><address index="0x0001"/></physical>
    </parameter>

    <parameter id="CENTRAL_ADDRESS" hidden="true">
      <logical type="integer"/>
      <physical interface="eeprom" size="4" type="integer"><address index="0x0002"/></physical>
    </parameter>
    <enforce id="CENTRAL_ADDRESS" value="1"/>

    <parameter id="DIRECT_LINK_DEACTIVATE" hidden="true">
      <logical default="false" type="boolean"/>
      <physical interface="eeprom" size="0.1" type="integer"><address index="0x0006"/></physical>
    </parameter>
    <enforce id="DIRECT_LINK_DEACTIVATE" value="true"/>

    <!-- Ab hier: echte Betriebsparameter des Gateways, aus der CCU aenderbar. -->
    <parameter id="CARRIER_SENSE">
      <logical default="false" type="boolean"/>
      <physical interface="eeprom" size="1.0" type="integer"><address index="0x0007"/></physical>
    </parameter>
    <parameter id="BUS_IDLE_TIME">
      <logical type="integer" unit="ms" default="5" min="1" max="255"/>
      <physical interface="eeprom" size="1.0" type="integer"><address index="0x0008"/></physical>
    </parameter>
    <parameter id="RETRANSMIT">
      <logical default="false" type="boolean"/>
      <physical interface="eeprom" size="1.0" type="integer"><address index="0x0009"/></physical>
    </parameter>
    <parameter id="SEND_RETRIES">
      <logical type="integer" default="3" min="1" max="10"/>
      <physical interface="eeprom" size="1.0" type="integer"><address index="0x000A"/></physical>
    </parameter>
    <parameter id="ACK_WAIT_TIME">
      <logical type="integer" unit="ms" default="400" min="50" max="2000"/>
      <physical interface="eeprom" size="2.0" type="integer"><address index="0x000B"/></physical>
    </parameter>
    <parameter id="RX_TIMEOUT">
      <logical type="integer" unit="s" default="60" min="10" max="3600"/>
      <physical interface="eeprom" size="2.0" type="integer"><address index="0x000D"/></physical>
    </parameter>

  </paramset>

  <channels>
    <channel class="maintenance" count="1" index="0" type="MAINTENANCE" ui_flags="internal">
      <paramset id="maint_ch_master" type="MASTER"/>
      <paramset id="maint_ch_values" type="VALUES">
        <parameter id="UNREACH" operations="read,event" ui_flags="service">
          <logical type="boolean"/>
          <physical interface="internal" type="integer" value_id="UNREACH"/>
        </parameter>
        <parameter id="STICKY_UNREACH" operations="read,write,event" ui_flags="service">
          <logical type="boolean"/>
          <physical interface="internal" type="integer" value_id="STICKY_UNREACH"/>
        </parameter>
        <parameter id="CONFIG_PENDING" operations="read,event" ui_flags="service">
          <logical type="boolean"/>
          <physical interface="internal" type="integer" value_id="CONFIG_PENDING"/>
        </parameter>
      </paramset>
    </channel>
  </channels>

</device>
